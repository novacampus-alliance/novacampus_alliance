<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <style>
    body { margin: 0; padding: 0; background: #f4f6f8; font-family: Arial, sans-serif; }
    .wrapper { max-width: 600px; margin: 40px auto; }
    .header { background: #1a56db; padding: 24px 32px; border-radius: 8px 8px 0 0; }
    .header h1 { color: #ffffff; margin: 0; font-size: 20px; }
    .body { background: #ffffff; padding: 32px; border-left: 1px solid #e2e8f0; border-right: 1px solid #e2e8f0; }
    .greeting { color: #1a202c; font-size: 16px; margin-bottom: 16px; }
    .message { color: #2d3748; font-size: 15px; line-height: 1.6; }
    .details { background: #f7fafc; border-left: 4px solid #1a56db; padding: 12px 16px; margin-top: 20px; color: #4a5568; font-size: 14px; }
    .footer { background: #f4f6f8; padding: 16px 32px; border-radius: 0 0 8px 8px; border: 1px solid #e2e8f0; border-top: none; }
    .footer p { color: #a0aec0; font-size: 12px; margin: 0; }
  </style>
</head>
<body>
  <div class="wrapper">
    <div class="header">
      <h1>NovaCampus — {{title}}</h1>
    </div>
    <div class="body">
      <p class="greeting">Bonjour {{firstName}},</p>
      <p class="message">{{message}}</p>
      {{#if details}}
      <div class="details">{{details}}</div>
      {{/if}}
    </div>
    <div class="footer">
      <p>Ce message a été envoyé automatiquement par NovaCampus. Merci de ne pas y répondre directement.</p>
    </div>
  </div>
</body>
</html>
