# ─────────────────────────────────────────────────────────────
# Novacampus Alliance — Backend (NestJS)
# Copier ce fichier en .env et remplir les valeurs
# NE PAS committer le fichier .env
# ─────────────────────────────────────────────────────────────

# ── PostgreSQL / Prisma ──────────────────────────────────────
# Chaîne de connexion Prisma vers PostgreSQL
# Format : postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# Doit correspondre aux variables POSTGRES_* du docker-compose.yml
DATABASE_URL=postgresql://novacampus_user:change_me_postgres@localhost:5432/novacampus_db?schema=public

# ── Authentification JWT ─────────────────────────────────────
# Secret utilisé pour signer et vérifier les tokens JWT
# Générer une valeur forte en production (ex: openssl rand -base64 64)
JWT_SECRET=change_me_with_a_strong_secret

# Durée de validité du token JWT (ex: 7d, 24h, 60m)
JWT_EXPIRES_IN=7d

# ── Redis ────────────────────────────────────────────────────
# Cache, sessions et files d'attente
# Format : redis://:PASSWORD@HOST:PORT
# Doit correspondre aux variables REDIS_* du docker-compose.yml
REDIS_URL=redis://:change_me_redis@localhost:6379

# ── MongoDB (optionnel) ─────────────────────────────────────
# Logs, documents et données NoSQL (factures PDF, historique relances IA)
# Format : mongodb://USER:PASSWORD@HOST:PORT/DATABASE?authSource=admin
MONGO_URI=mongodb://mongo_admin:change_me_mongo@localhost:27017/novacampus_nosql?authSource=admin

# ── Service IA ───────────────────────────────────────────────
# URL interne du service FastAPI (agent de relance financière)
AI_SERVICE_URL=http://localhost:8000

# ── Application ────────────────────────────────────────────────
# Port d'écoute du serveur NestJS
PORT=3001

# Environnement d'exécution
# Valeurs : development | production | test
NODE_ENV=development

# Origines autorisées pour CORS (séparées par des virgules)
CORS_ORIGINS=http://localhost:3000
