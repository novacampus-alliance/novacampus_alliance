# ─── PostgreSQL ───────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/novacampus?schema=public"

# ─── Auth ─────────────────────────────────────────────────────
JWT_SECRET=change_me_with_a_strong_secret
JWT_EXPIRES_IN=7d

# ─── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── App ──────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ─── AI Service ───────────────────────────────────────────────
AI_SERVICE_URL=http://localhost:8000
