          }
        }
      ]
    },
    {
      "name": "2 — Lecture (GET /notifications)",
      "item": [
        {
          "name": "GET notifications — utilisateur connecté",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Statut 200', () => pm.response.to.have.status(200));",
                "let body; try { body = pm.response.json(); } catch(e) {}",
                "if (!body) return;",
                "pm.test('Champs count et data présents', () => {",
                "  pm.expect(body).to.have.property('count');",
                "  pm.expect(body).to.have.property('data');",
                "  pm.expect(body.data).to.be.an('array');",
                "});",
                "if (body.data && body.data.length > 0) {",
                "  pm.collectionVariables.set('notification_id', body.data[0].notification_id);",
                "  const n = body.data[0];",
                "  pm.test('Structure notification valide', () => {",
                "    pm.expect(n).to.have.keys(['notification_id','type','message','sent_at','read']);",
                "  });",
                "  pm.test('read est un booléen', () => pm.expect(n.read).to.be.a('boolean'));",
                "}"
              ],
              "type": "text/javascript"
            }
          }],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "method": "GET",
            "url": "{{base_url}}/api/notifications"
          }
        },
        {
          "name": "GET notifications — sans token → 401",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Statut 401 sans token', () => pm.response.to.have.status(401));"
              ],
              "type": "text/javascript"
            }
          }],
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/notifications"
          }
        }
      ]
    },
    {
      "name": "3 — Marquer comme lu (PUT /:id/lire)",
      "item": [
        {
          "name": "PUT :id/lire — marque la première notification",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Statut 200', () => pm.response.to.have.status(200));",
                "let body; try { body = pm.response.json(); } catch(e) {}",
                "if (body) {",
                "  pm.test('read = true', () => pm.expect(body.read).to.equal(true));",
                "  pm.test('notification_id présent', () => pm.expect(body.notification_id).to.be.a('string'));",
                "}"
              ],
              "type": "text/javascript"
            }
          }],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "method": "PUT",
            "url": "{{base_url}}/api/notifications/{{notification_id}}/lire"
          }
        },
        {
          "name": "GET notifications — vérifie read=true après",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Statut 200', () => pm.response.to.have.status(200));",
                "let body; try { body = pm.response.json(); } catch(e) {}",
                "if (!body || !body.data) return;",
                "const target = body.data.find(n => n.notification_id === pm.collectionVariables.get('notification_id'));",
                "if (target) pm.test('Notification bien marquée lue', () => pm.expect(target.read).to.equal(true));"
              ],
              "type": "text/javascript"
            }
          }],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "method": "GET",
            "url": "{{base_url}}/api/notifications"
          }
        },
        {
          "name": "PUT :id/lire — ID inexistant → 404",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Statut 404 — notification inexistante', () => pm.response.to.have.status(404));"
              ],
              "type": "text/javascript"
            }
          }],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "method": "PUT",
            "url": "{{base_url}}/api/notifications/id-qui-nexiste-pas/lire"
          }
        },
        {
          "name": "PUT :id/lire — sans token → 401",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Statut 401 sans token', () => pm.response.to.have.status(401));"
              ],
              "type": "text/javascript"
            }
          }],
          "request": {
            "method": "PUT",
            "url": "{{base_url}}/api/notifications/{{notification_id}}/lire"
          }
        }
      ]
    },
