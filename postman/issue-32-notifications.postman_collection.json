        {
          "name": "POST internal — ni user_id ni student_id → body vide",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Statut 201', () => pm.response.to.have.status(201));",
                "let body; try { body = pm.response.json(); } catch(e) {}",
                "pm.test('Body vide ou null (aucun destinataire)', () => pm.expect(body == null || body === '').to.equal(true));"
              ],
              "type": "text/javascript"
            }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
