            }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_id\": \"{{user_id}}\",\n  \"type\": \"PAYMENT_OVERDUE\",\n  \"message\": \"Votre paiement (FAC-2026-00001) de 750 EUR est en retard depuis le 01/06/2026. Veuillez régulariser votre situation.\"\n}"
