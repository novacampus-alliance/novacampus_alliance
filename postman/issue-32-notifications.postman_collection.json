                "let body; try { body = pm.response.json(); } catch(e) {}",
                "if (body && body.notification_id) {",
                "  pm.collectionVariables.set('notification_id', body.notification_id);",
                "  pm.test('notification_id présent', () => pm.expect(body.notification_id).to.be.a('string'));",
                "} else {",
                "  pm.test('⚠ Body vide — student_id non renseigné ou user introuvable', () => pm.expect(pm.collectionVariables.get('student_id')).to.not.be.empty);",
                "}"
              ],
              "type": "text/javascript"
            }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"student_id\": \"{{student_id}}\",\n  \"type\": \"PAYMENT_REMINDER\",\n  \"message\": \"Votre paiement de 1500.00 EUR est dû dans 3 jours (13/06/2026).\",\n  \"details\": \"Référence paiement : PAY-2026-00042\"\n}"
            },
            "url": "{{base_url}}/api/notifications/internal"
          }
        },
