                "pm.test('Statut 201', () => pm.response.to.have.status(201));",
                "let body; try { body = pm.response.json(); } catch(e) {}",
                "if (body && body.notification_id) pm.collectionVariables.set('notification_id', body.notification_id);"
              ],
