{
  "info": {
    "name": "Novacampus — Issue #11 Programmes",
    "description": "Tests du module programs via le gateway (:3001).\n\nPrérequis :\n- academic-service sur :3002\n- gateway sur :3001\n- postgres/redis démarrés\n\nNotes :\n- adresse campus : address, city, postal_code, region (pas country)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost" },
    { "key": "token", "value": "" },
    { "key": "campus_id", "value": "" },
    { "key": "program_id", "value": "" }
  ],
  "item": [
    {
      "name": "0 — Auth",
      "item": [
        {
          "name": "Login (admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200 || pm.response.code === 201) {",
                  "  const json = pm.response.json();",
                  "  pm.collectionVariables.set('token', json.access_token);",
                  "  pm.test('Token reçu', () => pm.expect(json.access_token).to.be.a('string'));",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@novacampus.fr\",\n  \"password\": \"Novacampus2026!\"\n}"
            },
            "url": "{{base_url}}/api/auth/login"
          }
        }
      ]
    },
    {
      "name": "1 — Prérequis (campus)",
      "item": [
        {
          "name": "Liste campus",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const list = pm.response.json();",
                  "  if (list.length > 0) {",
                  "    pm.collectionVariables.set('campus_id', list[0].campus_id);",
                  "  }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "method": "GET",
            "url": "{{base_url}}/api/campus"
          }
        },
        {
          "name": "Créer campus (si liste vide)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200 || pm.response.code === 201) {",
                  "  pm.collectionVariables.set('campus_id', pm.response.json().campus_id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"campus_name\": \"Campus Lyon Test\",\n  \"adresse\": {\n    \"address\": \"10 place Bellecour\",\n    \"city\": \"Lyon\",\n    \"postal_code\": \"69001\",\n    \"region\": \"Auvergne-Rhone-Alpes\"\n  },\n  \"status\": \"actif\"\n}"
            },
            "url": "{{base_url}}/api/campus"
          }
        }
      ]
    },
    {
      "name": "2 — Programmes (#11)",
      "item": [
        {
          "name": "GET — Liste programmes",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "method": "GET",
            "url": "{{base_url}}/api/programs"
          }
        },
        {
          "name": "GET — Liste filtrée (campus)",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/programs?campus_id={{campus_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "programs"],
              "query": [{ "key": "campus_id", "value": "{{campus_id}}" }]
            }
          }
        },
        {
          "name": "POST — Créer programme",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200 || pm.response.code === 201) {",
                  "  pm.collectionVariables.set('program_id', pm.response.json().program_id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"campus_id\": \"{{campus_id}}\",\n  \"program_name\": \"Master Data Science\",\n  \"program_type\": \"master\",\n  \"duration_years\": 2,\n  \"annual_tuition\": 8500,\n  \"department\": \"Informatique\",\n  \"coordinator\": \"Dr. Sophie Bernard\",\n  \"max_students\": 120,\n  \"status\": \"actif\"\n}"
            },
            "url": "{{base_url}}/api/programs"
          }
        },
        {
          "name": "GET — Détail programme",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "method": "GET",
            "url": "{{base_url}}/api/programs/{{program_id}}"
          }
        },
        {
          "name": "PUT — Mettre à jour programme",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"program_name\": \"Master Data Science & IA\",\n  \"max_students\": 150,\n  \"status\": \"actif\"\n}"
            },
            "url": "{{base_url}}/api/programs/{{program_id}}"
          }
        }
      ]
    }
  ]
}
