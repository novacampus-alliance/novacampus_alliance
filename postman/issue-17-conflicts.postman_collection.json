{
  "info": {
    "name": "Novacampus — Issue #17 Conflits salles & enseignants",
    "description": "Détection des conflits EDT via le gateway.\n\nIMPORTANT :\n- POST /schedules refuse les doublons (409) — un 2e créneau identique n'est PAS inséré en base.\n- Pour tester GET /conflicts avec des données réelles, exécuter d'abord :\n  cd services/academic-service && npm run prisma:seed:m7-conflict\n\nProcédure recommandée :\n1. Login\n2. Seed M7 (terminal) ou prérequis manuels\n3. GET /api/schedules/conflicts\n4. Vérifier type room | instructor",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost" },
    { "key": "token", "value": "" },
    { "key": "campus_id", "value": "" },
    { "key": "program_id", "value": "" },
    { "key": "instructor_id", "value": "" },
    { "key": "course_id", "value": "" },
    { "key": "course_id_2", "value": "" },
    { "key": "room_id", "value": "" },
    { "key": "schedule_id", "value": "" },
    { "key": "course_code", "value": "" },
    { "key": "course_code_2", "value": "" }
  ],
  "item": [
    {
      "name": "0 — Auth",
      "item": [{
        "name": "Login (admin)",
        "event": [{ "listen": "test", "script": { "exec": ["if (pm.response.code === 200 || pm.response.code === 201) pm.collectionVariables.set('token', pm.response.json().access_token);"], "type": "text/javascript" } }],
        "request": {
          "method": "POST",
          "header": [{ "key": "Content-Type", "value": "application/json" }],
          "body": { "mode": "raw", "raw": "{\n  \"email\": \"admin@novacampus.fr\",\n  \"password\": \"Novacampus2026!\"\n}" },
          "url": "{{base_url}}/api/auth/login"
        }
      }]
    },
    {
      "name": "1 — Prérequis campus",
      "item": [
        { "name": "Liste campus", "event": [{ "listen": "test", "script": { "exec": ["const l=pm.response.json(); if(pm.response.code===200&&l.length) pm.collectionVariables.set('campus_id',l[0].campus_id);"], "type": "text/javascript" } }], "request": { "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] }, "method": "GET", "url": "{{base_url}}/api/campus" } }
      ]
    },
    {
      "name": "2 — Détection conflits (#17)",
      "item": [
        {
          "name": "GET — Conflits (salle + enseignant)",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Conflits listés', () => pm.expect(pm.response.code).to.equal(200));",
                "const conflicts = pm.response.json();",
                "pm.test('Au moins un conflit (seed M7 requis)', () => {",
                "  pm.expect(conflicts.length, 'npm run prisma:seed:m7-conflict').to.be.above(0);",
                "});",
                "if (conflicts.length) {",
                "  const types = [...new Set(conflicts.map(c => c.type))];",
                "  console.log('Types détectés:', types.join(', '));",
                "}"
              ],
              "type": "text/javascript"
            }
          }],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "method": "GET",
            "url": { "raw": "{{base_url}}/api/schedules/conflicts?campus_id={{campus_id}}", "host": ["{{base_url}}"], "path": ["api", "schedules", "conflicts"], "query": [{ "key": "campus_id", "value": "{{campus_id}}" }] }
          }
        }
      ]
    },
    {
      "name": "3 — Garde API (409 attendu)",
      "item": [
        {
          "name": "POST — Créneau 1",
          "event": [{ "listen": "test", "script": { "exec": ["if(pm.response.code===200||pm.response.code===201) pm.collectionVariables.set('schedule_id',pm.response.json().schedule_id);"], "type": "text/javascript" } }],
          "request": { "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] }, "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"course_id\": \"{{course_id}}\",\n  \"instructor_id\": \"{{instructor_id}}\",\n  \"room_id\": \"{{room_id}}\",\n  \"day_of_week\": 3,\n  \"start_time\": \"10:00\",\n  \"end_time\": \"12:00\",\n  \"academic_year\": \"2025-2026\",\n  \"status\": \"planifie\"\n}" }, "url": "{{base_url}}/api/schedules" }
        },
        {
          "name": "POST — Créneau 2 doublon (409 attendu)",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Doublon refusé par l\\'API', () => pm.expect(pm.response.code).to.equal(409));",
                "const body = pm.response.json();",
                "pm.test('Type conflit salle', () => pm.expect(body.type || body.message).to.exist);"
              ],
              "type": "text/javascript"
            }
          }],
          "request": { "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] }, "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"course_id\": \"{{course_id_2}}\",\n  \"instructor_id\": \"{{instructor_id}}\",\n  \"room_id\": \"{{room_id}}\",\n  \"day_of_week\": 3,\n  \"start_time\": \"10:00\",\n  \"end_time\": \"12:00\",\n  \"academic_year\": \"2025-2026\",\n  \"status\": \"planifie\"\n}" }, "url": "{{base_url}}/api/schedules" }
        }
      ]
    }
  ]
}
