# ─────────────────────────────────────────────────────────────
# Novacampus Alliance — Frontend (Next.js 14)
# Copier ce fichier en .env.local pour le développement local
# NE PAS committer .env.local
# ─────────────────────────────────────────────────────────────

# URL de l'API backend NestJS (exposée au navigateur via NEXT_PUBLIC_)
# Utilisée par les appels fetch/axios depuis les portails IHM
NEXT_PUBLIC_API_URL=http://localhost:3001

# URL publique du frontend (utile pour les redirections OAuth / liens absolus)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Environnement d'exécution Next.js
# Valeurs : development | production | test
NODE_ENV=development
