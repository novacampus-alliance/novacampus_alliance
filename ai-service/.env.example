# ─────────────────────────────────────────────────────────────
# Novacampus Alliance — AI Service (FastAPI + LangChain)
# Copier ce fichier en .env et remplir les valeurs
# NE PAS committer le fichier .env
# ─────────────────────────────────────────────────────────────

# ── Application ────────────────────────────────────────────────
# Active les logs détaillés et le mode debug FastAPI
# Valeurs : true | false
DEBUG=false

# Port d'écoute du serveur uvicorn
PORT=8000

# ── LLM (OpenAI) ─────────────────────────────────────────────
# Clé API OpenAI pour la génération de relances personnalisées
# Obtenir une clé sur : https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Modèle LLM utilisé pour la rédaction des relances
# Exemples : gpt-4o-mini | gpt-4o | gpt-4-turbo
OPENAI_MODEL=gpt-4o-mini

# ── MongoDB ──────────────────────────────────────────────────
# Stockage des brouillons de relances, historique et logs IA
# Format : mongodb://USER:PASSWORD@HOST:PORT
MONGODB_URL=mongodb://mongo_admin:change_me_mongo@localhost:27017

# Nom de la base de données dédiée au service IA
MONGODB_DB=novacampus_ai

# ── Redis ────────────────────────────────────────────────────
# Cache des contextes étudiants et files de tâches asynchrones
# Format : redis://:PASSWORD@HOST:PORT
REDIS_URL=redis://:change_me_redis@localhost:6379

# ── Backend NestJS ─────────────────────────────────────────────
# URL interne du gateway SOA pour récupérer les données PAYMENTS
BACKEND_URL=http://localhost:3001

# ── CORS ─────────────────────────────────────────────────────
# Origines autorisées (format JSON array)
# Le frontend Next.js et les services NestJS doivent y figurer
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:3001"]

# ── Agent de relance — seuils d'escalade ─────────────────────
# Nombre de jours de retard avant escalade automatique vers un humain
ESCALADE_SEUIL_JOURS=30

# Nombre de relances envoyées sans réponse avant escalade
ESCALADE_SEUIL_RELANCES=3
