# ─────────────────────────────────────────────────────────────
# Novacampus Alliance — AI Service (FastAPI + LangChain)
# Copier ce fichier en .env et remplir les valeurs
# NE PAS committer le fichier .env
# ─────────────────────────────────────────────────────────────

DEBUG=false
PORT=8000

# ── LLM Provider ─────────────────────────────────────────────
# Valeurs : groq | openai | ollama | template
# Prod VPS 4 Go recommandé : groq ou template
LLM_PROVIDER=groq

# Groq (clés gsk_...) — https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

# OpenAI (optionnel) — https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Ollama (dev local uniquement)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b

# ── Auth JWT (identique au svc académique) ───────────────────
JWT_SECRET=change_me_with_a_strong_secret

# ── MongoDB ──────────────────────────────────────────────────
MONGODB_URL=mongodb://mongo_admin:change_me_mongo@localhost:27017
MONGODB_DB=novacampus_ai

# ── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://:change_me_redis@localhost:6379

# ── Gateway SOA ──────────────────────────────────────────────
BACKEND_URL=http://localhost:3001

ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:3001"]
