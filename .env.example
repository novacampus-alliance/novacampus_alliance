# ─────────────────────────────────────────
# Novacampus Alliance — Variables d'environnement
# Copier ce fichier en .env et remplir les valeurs
# NE PAS committer le fichier .env
# ─────────────────────────────────────────

# ── PostgreSQL ────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=novacampus_db
POSTGRES_USER=novacampus_user
POSTGRES_PASSWORD=change_me_postgres

# URL Prisma (construite à partir des variables ci-dessus)
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}?schema=public

# ── MongoDB ───────────────────────────────
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DB=novacampus_nosql
MONGO_ROOT_USER=mongo_admin
MONGO_ROOT_PASSWORD=change_me_mongo

# URI de connexion MongoDB
MONGO_URI=mongodb://${MONGO_ROOT_USER}:${MONGO_ROOT_PASSWORD}@${MONGO_HOST}:${MONGO_PORT}/${MONGO_DB}?authSource=admin

# ── Redis ─────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change_me_redis

# URI de connexion Redis
REDIS_URL=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}
