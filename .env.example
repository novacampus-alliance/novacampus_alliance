# ─────────────────────────────────────────
# Novacampus Alliance — Variables d'environnement
# Copier ce fichier en .env et remplir les valeurs
# NE PAS committer le fichier .env
# ─────────────────────────────────────────

# ── PostgreSQL ────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=novacampus_db
POSTGRES_USER=novacampus_user
POSTGRES_PASSWORD=change_me_postgres

# URL Prisma (construite à partir des variables ci-dessus)
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}?schema=public

# ── MongoDB ───────────────────────────────
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DB=novacampus_nosql
MONGO_ROOT_USER=mongo_admin
MONGO_ROOT_PASSWORD=change_me_mongo

# URI de connexion MongoDB
MONGO_URI=mongodb://${MONGO_ROOT_USER}:${MONGO_ROOT_PASSWORD}@${MONGO_HOST}:${MONGO_PORT}/${MONGO_DB}?authSource=admin

# ── Redis ─────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change_me_redis

# URI de connexion Redis
REDIS_URL=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}

# ── Auth JWT ──────────────────────────────
JWT_SECRET=change_me_with_a_strong_secret
JWT_EXPIRES_IN=7d

# ── Services SOA (Docker Compose) ─────────
GATEWAY_PORT=3001
FRONTEND_PORT=3000
AI_SERVICE_PORT=8000
CORS_ORIGINS=http://localhost:3000

# URLs internes (gateway → services, configurées dans docker-compose)
ACADEMIC_SERVICE_URL=http://academic-service:3002
BILLING_SERVICE_URL=http://billing-service:3003
NOTIFICATION_SERVICE_URL=http://notification-service:3004

# URLs publiques (utilisées par le navigateur → gateway uniquement)
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Service IA ────────────────────────────
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_DEBUG=false
AI_MONGODB_DB=novacampus_ai
